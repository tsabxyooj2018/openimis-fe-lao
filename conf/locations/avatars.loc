
    # User photographs, served by the avatar sidecar. Mapped under the main site
    # so the browser stays same-origin: session cookies and the CSRF token apply
    # without CORS, and no second Cloudflare hostname is needed.
    location /avatars/ {
            proxy_pass http://${avatars}/;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto https;
            # The service caps uploads at 3MB; refuse larger bodies at the edge
            # rather than carrying them across the network first.
            client_max_body_size 3m;
    }
